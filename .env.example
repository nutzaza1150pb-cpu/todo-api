PORT=3333
HOST=0.0.0.0
NODE_ENV=development
APP_KEY=change-me-run-node-ace-generate-key
DRIVE_DISK=local

# เลือกฐานข้อมูล: pg (PostgreSQL) หรือ mysql (MariaDB/MySQL)
DB_CONNECTION=pg

PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB_NAME=todo_db

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB_NAME=todo_db
